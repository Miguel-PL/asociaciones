# Dependencias
/vendor/
/node_modules/

# Archivos de entorno
.env
.env.backup

# Archivos generados
/storage/logs/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*

# Conservar la estructura necesaria de Laravel
!/storage/framework/cache/data/
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore

# IDE
/.idea/
/.vscode/
*.swp
*.swo

# Sistema
.DS_Store
Thumbs.db

# Laravel specific
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/public/build/
/public/hot
/public/storage
/public/sites
/storage/*.key
/.phpunit.result.cache

# Archivos subidos localmente: no versionar
/storage/app/private/*
/storage/app/public/*
!/storage/app/private/.gitignore
!/storage/app/public/.gitignore
