APP_NAME="Asociaciones"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://caudete-se-mueve.test
APP_TIMEZONE="Europe/Madrid"
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asociaciones
DB_USERNAME=asociaciones
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Sitio por defecto cuando el dominio no coincide con ninguno declarado.
SITE_DEFAULT=caudete-se-mueve

# Sitio forzado. Vacio = cada dominio .test sirve su propio sitio.
# Pon el nombre de la carpeta en sites/ (p. ej. caudete-se-mueve) para
# trabajar siempre en un solo sitio. En produccion debe quedar vacio.
SITE=
